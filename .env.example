# Database Configurations
# Canonical PostgreSQL URL
DATABASE_URL=postgresql://user:password@localhost:5432/dbname
# SQLite fallback is enabled by default for local environment if postgres is unreachable
SQLITE_FALLBACK=True

# Authentication
# Generate a cryptographically secure random token (e.g. openssl rand -hex 32)
JWT_SECRET=your_jwt_secret_token_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LLM API (Optional - falls back to local grounded insights generator if empty)
LLM_API_KEY=your_llm_api_key_here

# App environment (development, testing, production)
ENVIRONMENT=development
