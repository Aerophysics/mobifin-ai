# Database Configurations
# Canonical PostgreSQL URL
DATABASE_URL=postgresql://user:password@localhost:5432/dbname
# SQLite fallback is enabled by default for local environment if postgres is unreachable
SQLITE_FALLBACK=True

# Authentication
# Generate a cryptographically secure random token (e.g. openssl rand -hex 32)
JWT_SECRET=your_jwt_secret_token_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# If JWT_SECRET is unset, a random secret is generated once and stored in backend/.jwt_secret

# USSD / SMS gateway (Optional)
# Shared secret a real USSD gateway sends in the X-USSD-Gateway-Key header to call /api/ussd/*.
# Without it, only logged-in agents (their own referrals) and admins can drive the USSD simulator.
USSD_GATEWAY_KEY=

# LLM API (Optional - falls back to local grounded insights generator if empty)
LLM_API_KEY=your_llm_api_key_here

# App environment (development, testing, production)
ENVIRONMENT=development
